+        except Exception as exc:
+            checks.append({"check": label, "result": "FAIL",
+                           "detail": f"{type(exc).__name__}: {str(exc)[:150]}"})
+        print("  %-4s %-46s %s" % (checks[-1]["result"], label, str(checks[-1]["detail"])[:62]))
+
+    admin = psycopg2.connect(libpq(APP_URL))
