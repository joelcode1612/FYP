+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(evidence, indent=2, ensure_ascii=False, default=str), encoding="utf-8")
+    print("\n  %d/%d checks passed" % (passed, len(checks)))
+    print("  evidence:", out)
