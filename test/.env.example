# PostgreSQL connection for the Sitewise backend.
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored at the repository root, so it never reaches version
# control. Never commit real credentials, and never expose them to the client:
# the browser bundle and the Flutter app must not contain any of these values.
#
# These variable names are PostgreSQL's own conventions (the `PG*` prefix), so
# `psql` and any other libpq client on this machine pick them up automatically.

PGHOST=localhost
PGPORT=5432
PGDATABASE=Final_Location_Analysis
PGUSER=postgres
PGPASSWORD=replace-with-your-password

# Connection pool sizing. Ten is ample for a single-developer FYP workload and
# keeps the backend well inside PostgreSQL's default max_connections (100).
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000
PGCONNECT_TIMEOUT_MS=5000

# Application API. The original research API remains on port 3000.
APP_API_PORT=3001
APP_ORIGINS=http://localhost:8090,http://127.0.0.1:8090,http://localhost:8091,http://127.0.0.1:8091
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# No Supabase secret/service-role key is needed by this integration.
