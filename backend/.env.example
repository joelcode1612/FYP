# Sitewise FastAPI backend - copy to .env and fill real values.
#
#   cp backend/.env.example backend/.env
#
# `backend/.env` is UNTRACKED and git-ignored. It must never be committed.
# This template is the only environment file that belongs in version control.
#
# SECURITY: every value below is a placeholder. If you find a real-looking
# value in this file, treat it as exposed: replace it here, rotate the
# credential at its provider, and do not reuse it. Git history is not a
# secret store — deleting a value later does not remove it from history.

# --- Application database (profiles, saved properties, recommendations) ----
DATABASE_URL=

# --- Analytics database (same DB: DOSM statistics, geospatial features) -----
ANALYTICS_DATABASE_URL=

# --- Application -----------------------------------------------------------
LOG_LEVEL=INFO
SECRET_KEY=
CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090,http://localhost:3000

# --- Supabase authentication (identity provider) ---------------------------
# Project Settings -> API. The publishable key is public by design; the
# secret key is SERVER-ONLY and is not required for token verification.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://YOUR-PROJECT-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCES=authenticated

# --- Third-party map / geocoding keys (server-side only) --------------------
CARTO_BASEMAPS_KEY=
GOOGLE_API_KEY=

# --- Cloud LLM provider (optional; disabled unless explicitly enabled) ------
# TOKENHARBOR_ENABLED defaults to false. Set it to true only in an
# environment that is authorised to spend against this key.
TOKENHARBOR_API_KEY=
# TOKENHARBOR_ENABLED=false

# --- Staff administration ----------------------------------------------------
# Redirect target embedded in agent invite / password-setup emails. MUST also
# be allow-listed in Supabase Auth -> URL Configuration -> Redirect URLs.
# Empty = first CORS origin + /auth/callback.
SUPABASE_STAFF_INVITE_REDIRECT_URL=http://localhost:8090/auth/callback
SUPABASE_INVITE_REDIRECT_URL=http://localhost:8090/auth/callback
# Timeout (seconds) for GoTrue admin REST calls not wrapped by supabase-py
# (MFA factor administration).
SUPABASE_ADMIN_TIMEOUT_SECONDS=15
GOOGLE_MAPS_API_KEY=

# --- PU gap-recovery local datasets (optional) ------------------------------
# Root of the Sitewise_PU_Gap_Recovery dataset (WorldPop age-sex GeoTIFFs,
# training-era CSVs). Provenance manifests are committed under
# backend/local_data/pu_gap_recovery/manifests/; the heavy data itself is NOT
# copied into the repository or Git — point this at the external copy. The
# runtime population feature path needs no local files: the total-population
# raster is ingested in PostgreSQL (public.worldpop_2025_constrained).
# SITEWISE_PU_GAP_DATA_ROOT=C:\path\to\Sitewise_PU_Gap_Recovery\data
# Single-file population-per-pixel GeoTIFF for the Rasterio enrichment
# fallback (used only when both PostGIS rasters lack coverage).
# SITEWISE_POPULATION_RASTER=C:\path\to\population.tif
# Directory with the 42 WorldPop age-sex structure GeoTIFFs (20 male + 20
# female five-year bands + T_F + T_M, ~1.2 GB) read by the ``age_population``
# enrichment category when an owner/agent adds a property. Provision with
# backend/scripts/data/fetch_worldpop_agesex.py. Empty => the category
# reports "unavailable: not configured" instead of estimating.
# SITEWISE_AGE_RASTER_DIR=C:\path\to\worldpop_agesex
