+def build(world, *, source_packet=None, context=None, store=None,
+          ledger_state=None, auth_error=None, monkeypatch=None):
+    from sitewise.project1 import ledger as ledger_module
+    from sitewise.project1 import objective_adapter
+    from sitewise.project1 import runs as runs_module
+
+    store = store or FakeStore(world)
