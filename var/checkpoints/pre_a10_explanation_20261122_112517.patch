+    assert detail["code"] == "BDJ_OBJECTIVE_EXECUTION_HELD"
+    assert detail["reason"] == "PROVIDER_NOT_CONFIGURED"
+    assert store.persisted == []
+    assert ledger_state.receipt[1] == "rejected"
+
+
+def test_persistence_failure_never_returns_proposals(monkeypatch):
+    world = make_world()
+    store = FakeStore(world)
