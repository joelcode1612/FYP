+    os.environ["PROJECT1_BCB_CONFIRMATION_VALIDITY_DAYS"] = "1"
+    return app, f"{scheme}://{ROLE}:{ROLE_PW}@{host}"
+
+
+APP_URL, M2_URL = install()
+
+
+def libpq(dsn):
