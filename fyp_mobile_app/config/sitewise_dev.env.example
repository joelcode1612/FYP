# SiteWise Flutter mobile — local development defines (SAMPLE / PLACEHOLDERS).
#
# Copy this file to `sitewise_dev.env` in this directory and fill in the values.
# `sitewise_dev.env` is git-ignored: it contains a Supabase PUBLISHABLE key.
# NEVER put the Supabase SECRET / service-role key in this file or any Flutter
# asset. The publishable key is designed for client builds; the secret key is
# server-only and already lives in backend/.env.
#
# Usage from the workspace root (C:\Users\Lenovo\AndroidStudioProjects\FYP):
#   flutter run -t fyp_mobile_app/lib/main.dart ^
#       --dart-define-from-file=fyp_mobile_app/config/sitewise_dev.env
#
# Android Studio: Run > Edit Configurations > main.dart > Additional run args:
#   --dart-define-from-file=$PROJECT_DIR$/fyp_mobile_app/config/sitewise_dev.env
#
# Start the unified backend first (binds the LAN so a phone can reach it):
#   .\run-sitewise.ps1 -BindHost 0.0.0.0
#
# ---- Target-specific API hosts -------------------------------------------
# Android EMULATOR:   API_BASE_URL=http://10.0.2.2:8090
# Physical device / iOS simulator: API_BASE_URL=http://<HOST-LAN-IP>:8090
# (this machine's Wi-Fi IPv4; find it with: ipconfig)
# WEB_BASE_URL must be an origin the PHONE's browser can open — use the LAN IP,
# never 10.0.2.2 or 127.0.0.1 for a physical device.
# The backend must be started with -BindHost 0.0.0.0 for LAN access.
#
# ---- Keys -----------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
API_BASE_URL=http://10.0.2.2:8090
WEB_BASE_URL=http://10.0.2.2:8090
