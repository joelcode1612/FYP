+        OB("O1", "D01_CONCEPT_INTENT_SYN", ("Q05",), construct_status=status)
+    ]
+    result = evaluate(
+        obligations,
+        effective_answers=full_answers(),
+        slot_constructs=SYNTHETIC_SLOT_CONSTRUCTS,
+    )
+    assert result.resolution("O1").status == HOLD_RELEASE_OBJECTIVE_COVERAGE
+    assert result.final_ready is False
+
+
+# ---------------------------------------------------------------------------
+# 14. D-4: objectives never substitute for the common core (can_submit).
+# ---------------------------------------------------------------------------
+def test_common_core_required_for_final_readiness():
+    result = evaluate(
+        synthetic_obligations(),
