  "stages": [
    {
      "code": "Q01",
      "title": "Assessment identity",
      "role": "m2",
      "sql": "SELECT id, owner_user_id, instrument_id, revision, confirmed_revision, created_at\nFROM m2_assessments\nWHERE id = '053b3768-145b-4d4a-a880-e98174adcd94';",
      "row_count": 1,
      "ok": true
    },
    {
      "code": "Q02",
      "title": "Item versions used by this assessment",
      "role": "m2",
      "sql": "SELECT i.item_key, i.id AS item_version_id, i.answer_kind, i.requiredness,\n       i.lifecycle, i.sort_order\nFROM m2_item_versions i\nWHERE i.instrument_id = (\n  SELECT instrument_id FROM m2_assessments WHERE id = '053b3768-145b-4d4a-a880-e98174adcd94')\nORDER BY i.sort_order;",
      "row_count": 19,
      "ok": true
    },
    {
      "code": "Q03",
      "title": "Answer revisions (structured codes and free text)",
      "role": "m2",
      "sql": "SELECT a.id AS answer_revision_id, i.item_key, a.assessment_revision,\n       a.answer_state, a.value_json\nFROM m2_answer_revisions a\nJOIN m2_item_versions i ON i.id = a.item_version_id\nWHERE a.assessment_id = '053b3768-145b-4d4a-a880-e98174adcd94'\nORDER BY i.sort_order, a.assessment_revision;",
      "row_count": 20,
      "ok": true
    },
    {
      "code": "Q04",
      "title": "Confirmation snapshot (the frozen source)",
      "role": "m2",
      "sql": "SELECT id, assessment_revision, actor_user_id, snapshot_digest, created_at\nFROM m2_confirmation_snapshots\nWHERE id = 'd2453af1-70e8-4be6-9fbe-20fe5e41b357';",
      "row_count": 1,
      "ok": true
    },
    {
      "code": "Q05",
      "title": "BCB context packet (hash + lifecycle)",
      "role": "m2",
      "sql": "SELECT context_id, assessment_id, confirmation_id, assessment_revision,\n       lifecycle_status, packet_hash, schema_version,\n       packet_json->>'confirmed_uncertainty' AS confirmed_uncertainty\nFROM m2_business_contexts\nWHERE context_id = 'fa3cb714-5145-57e9-97cd-0af92da80f46';",
      "row_count": 1,
      "ok": true
    },
    {
      "code": "Q06",
      "title": "BCB build lineage",
      "role": "m2",
      "sql": "SELECT confirmation_id, assessment_id, assessment_revision, status,\n       last_code, context_id, attempt_count, created_at, updated_at\nFROM m2_business_context_builds\nWHERE context_id = 'fa3cb714-5145-57e9-97cd-0af92da80f46'\nORDER BY created_at;",
      "row_count": 1,
      "ok": true
    },
    {
      "code": "Q07",
      "title": "AI run bound to this source",
      "role": "runtime",
      "sql": "SELECT id, work_identity, assessment_id, assessment_revision,\n       source_fingerprint, policy_fingerprint, created_at\nFROM project1_ai.runs\nWHERE assessment_id = '053b3768-145b-4d4a-a880-e98174adcd94' AND assessment_revision = 20\nORDER BY created_at DESC;",
      "row_count": 8,
      "ok": true
    },
    {
      "code": "Q08",
      "title": "Attempts and receipts for the run",
      "role": "runtime",
      "sql": "SELECT a.run_id, a.attempt_no, a.stage, a.prompt_version, a.prompt_hash,\n       a.request_hash, r.outcome, r.output_digest\nFROM project1_ai.attempts a\nLEFT JOIN project1_ai.attempt_receipts r\n  ON r.run_id = a.run_id AND r.attempt_no = a.attempt_no\nWHERE a.run_id IN (\n  SELECT id FROM project1_ai.runs\n  WHERE assessment_id = '053b3768-145b-4d4a-a880-e98174adcd94'\n)\nORDER BY a.run_id, a.attempt_no;",
      "row_count": 6,
      "ok": true
    },
    {
      "code": "Q09",
      "title": "BDJ objective proposals",
      "role": "m2",
      "sql": "SELECT proposal_id, confirmation_revision, recommendation_status,\n       problem_type, research_objective, validation_status, review_state,\n       execution_mode, model_provider, source_fingerprint, created_at\nFROM m2_bdj_objective_proposals\nWHERE assessment_id = '053b3768-145b-4d4a-a880-e98174adcd94'\nORDER BY created_at;",
      "row_count": 3,
      "ok": true
    },
    {
      "code": "Q10",
      "title": "Owner decisions on proposals (approval is not admission)",
      "role": "m2",
      "sql": "SELECT decision_id, proposal_id, decision, decided_by, decided_at, note\nFROM m2_bdj_objective_decisions\nWHERE proposal_id IN (\n  SELECT proposal_id FROM m2_bdj_objective_proposals\n  WHERE assessment_id = '053b3768-145b-4d4a-a880-e98174adcd94')\nORDER BY decided_at;",
      "row_count": 3,
      "ok": true
    },
    {
      "code": "Q11",
      "title": "Admissions (the governed gate)",
      "role": "m2",
      "sql": "SELECT admission_id, proposal_id, objective_id, decision,\n       policy_version, policy_classification, policy_disposition,\n       policy_resolution, source_fingerprint, created_at\nFROM m2_bdj_objective_admissions\nWHERE assessment_id = '053b3768-145b-4d4a-a880-e98174adcd94'\nORDER BY created_at;",
      "row_count": 2,
      "ok": true
    },
    {
      "code": "Q12",
      "title": "Measurement specifications and their approval decisions",
      "role": "m2",
      "sql": "SELECT s.measurement_id, s.measurement_version, s.objective_id,\n       s.construct, s.status, s.response_format, s.content_digest\nFROM m2_measurement_specs s\nORDER BY s.measurement_id, s.measurement_version;",
      "row_count": 1,
      "ok": true
    },
    {
      "code": "Q13",
      "title": "Measurement decisions (who approved what, at which scope)",
      "role": "m2",
      "sql": "SELECT d.measurement_id, d.measurement_version, d.decision, d.authority,\n       d.scope, d.decided_at\nFROM m2_measurement_decisions d\nORDER BY d.measurement_id, d.decided_at;",
      "row_count": 2,
      "ok": true
    },
    {
      "code": "Q14",
      "title": "QG authorizations (single-use, narrowly bound)",
      "role": "m2",
      "sql": "SELECT authorization_id, objective_id, objective_admission_id,\n       measurement_id, measurement_version, source_fingerprint,\n       context_packet_hash, issued_at, expires_at, consumed_at\nFROM m2_qg_authorizations\nWHERE assessment_id = '053b3768-145b-4d4a-a880-e98174adcd94'\nORDER BY issued_at;",
      "row_count": 36,
      "ok": true
    },
    {
      "code": "Q15",
      "title": "QG candidates (the end of the chain)",
