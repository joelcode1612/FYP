# LOCAL DEVELOPMENT ONLY - contains a Supabase PUBLISHABLE key (public by
# design; NEVER put the secret / service-role key here).
# Used by .idea/runConfigurations/main_dart.xml via --dart-define-from-file.
#
# HOST SELECTION (verified on this machine): the target is a USB-attached
# physical Android device. The unified backend binds 127.0.0.1:8090, and
# .\run-sitewise.cmd installs `adb reverse tcp:8090 tcp:8090` when a device
# is attached. The phone therefore reaches the API at its OWN 127.0.0.1:8090.
# This needs no LAN IP, no 0.0.0.0 bind and no firewall rule, and it keeps
# working when the PC's Wi-Fi address changes.
#
# If you switch to the Android emulator, use API_HOST_MODE=emulator instead
# (http://10.0.2.2:8090). If you need a real LAN address, start the backend
# with .\run-sitewise.cmd -AllowLan and set API_BASE_URL to that PC IP.
#
# These are DART COMPILE-TIME defines: after editing this file you must STOP
# and RE-RUN the Flutter app. Starting run-sitewise.cmd only starts the
# server; it cannot change values already compiled into the APK.
SUPABASE_URL=https://lzdpjwmcjbhtkzkqudyt.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XzcdY9fStoqL26NgpIb5VQ_BpFGGLUR
API_HOST_MODE=adb-reverse
API_BASE_URL=http://127.0.0.1:8090
WEB_BASE_URL=http://127.0.0.1:8090
GOOGLE_WEB_CLIENT_ID=235856432090-un8doods8fc5f3bmvtgbjtvojbjg2spa.apps.googleusercontent.com

# DEV ONLY: skip Supabase sign-in and open the Entrepreneur workspace directly.
# Active in debug builds only (dev_auth_bypass.dart gates on kDebugMode), so a
# release APK is unaffected. Set to false (or delete this line) to restore login.
SITEWISE_DEV_AUTH_BYPASS=true
