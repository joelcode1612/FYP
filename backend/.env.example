# Sitewise FastAPI backend - copy to .env and fill real values.
# .env is git-ignored. NEVER commit credentials or put the secret key in any
# client-side code.

# --- Application database (profiles, saved properties, recommendations) ----
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/sitesense

# --- Analytics database (DOSM statistics, geospatial features; read-only) --
ANALYTICS_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/Final_Location_Analysis

# --- Application -----------------------------------------------------------
LOG_LEVEL=INFO
SECRET_KEY=generate-a-local-random-value
CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090,http://localhost:3000

# --- Supabase authentication (identity provider) ---------------------------
# Project Settings -> API. The publishable key is public by design; the
# secret key is SERVER-ONLY and is not required for token verification.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://YOUR-PROJECT-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCES=authenticated
