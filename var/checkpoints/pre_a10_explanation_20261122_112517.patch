+    def source_reader(session, user, assessment_id, revision):
+        from sitewise.core.exceptions import ConflictError
+        if (str(user.user_id) != str(world.owner)
+                or str(assessment_id) != str(world.assessment)
+                or revision != REVISION):
+            raise ConflictError("Confirm the current M2 declarations.")
+        return copy.deepcopy(source_packet or world.packet)
+
+    monkeypatch.setattr(objective_adapter, "persist", store.persist)
+    monkeypatch.setattr(objective_adapter, "read", store.read)
+    monkeypatch.setattr(objective_adapter, "read_for_assessment",
+                        store.read_for_assessment)
+    monkeypatch.setattr(objective_adapter, "decide", store.decide)
+    monkeypatch.setattr(objective_adapter, "read_decision", store.read_decision)
+    monkeypatch.setattr(objective_adapter, "admission_status",
+                        store.admission_status)
+    monkeypatch.setattr(ledger_module, "PostgresAttemptLedger",
+                        lambda *a, **k: FakeAttemptLedger(ledger_state))
+    monkeypatch.setattr(runs_module, "ensure_objective_run",
+                        lambda *a, **k: ledger_state.run_id)
+    monkeypatch.setattr(runs_module, "attempt_count",
+                        lambda *a, **k: len(ledger_state.reserves))
+    monkeypatch.setattr(runs_module, "latest_receipt",
+                        lambda *a, **k: ledger_state.receipt)
+
+    app = FastAPI()
+    app.include_router(workflow.router, prefix="/project1-workflow")
+    app.dependency_overrides[workflow.configuration_gate] = lambda: None
+    if auth_error is None:
+        app.dependency_overrides[api.require_entrepreneur] = lambda: SimpleNamespace(
+            user_id=world.owner, role="entrepreneur")
+    else:
+        def refuse():
+            raise HTTPException(401, detail={"code": "unauthorized"})
+        app.dependency_overrides[api.require_entrepreneur] = refuse
+    app.dependency_overrides[api.get_objective_source_db] = lambda: object()
+    app.dependency_overrides[api.get_workflow_packet_source] = lambda: source_reader
+    app.dependency_overrides[api.get_objective_context_service] = lambda: contexts
+    app.dependency_overrides[api.get_authorized_proposal_storage_engine] = lambda: object()
+    app.dependency_overrides[api.get_authorized_ledger_engine] = lambda: object()
+    return TestClient(app), store, ledger_state, contexts
