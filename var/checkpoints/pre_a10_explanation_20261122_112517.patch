+ROLE_PW = os.environ.get("PHASE2_M2_ROLE_PW", "m2_runtime_dev_only")
+
+
+def install():
+    for line in (BACKEND / ".env").read_text(encoding="utf-8", errors="ignore").splitlines():
+        if line.startswith("DATABASE_URL="):
+            base = line.split("=", 1)[1].strip()
