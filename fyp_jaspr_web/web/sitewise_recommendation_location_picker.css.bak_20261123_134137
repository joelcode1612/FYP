/* Scoped SiteWise Recommendations location picker */
.rec2-location {border:1px solid #d7dfe9;border-radius:16px;background:#f9fbff;padding:18px;margin:12px 0 22px;color:#101c30}
.rec2-location__title {display:flex;align-items:center;gap:8px;font-size:17px;font-weight:750;margin:0}
.rec2-location__intro {color:#556577;font-size:14px;line-height:1.55;margin:5px 0 14px}
.rec2-location__methods {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.rec2-location__field {display:flex;flex-direction:column;gap:6px;min-width:0}
.rec2-location__field--full {grid-column:1/-1}
.rec2-location__label {font-weight:650;font-size:13px;color:#30405a}
.rec2-location input,.rec2-location select {height:44px;width:100%;box-sizing:border-box;padding:0 12px;border:1px solid #bfcbd9;border-radius:10px;background:white;color:#111827;font:inherit;font-size:15px}
.rec2-location__address {display:grid;grid-template-columns:minmax(0,1fr) auto;gap:9px}
.rec2-location__actions {display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:13px}
.rec2-location__btn {min-height:44px;padding:10px 15px;background:white;border:1px solid #b8c8e2;border-radius:10px;color:#194aac;font-weight:700;cursor:pointer;font-size:14px}
.rec2-location__btn--primary {background:#1d4ed8;border-color:#1d4ed8;color:white}
.rec2-location__btn:disabled {opacity:.55;cursor:not-allowed}
.rec2-location__status {font-size:13px;line-height:1.5;color:#4c5f74;margin:9px 0 0}
.rec2-location__status--error {color:#ab3030}
.rec2-location__hint {font-size:12px;line-height:1.5;color:#5b6474;margin:9px 0 0}
.rec2-location-modal-open {overflow:hidden}
.rec2-location-backdrop {position:fixed;inset:0;background:rgba(12,23,42,.65);display:grid;place-items:center;z-index:99999;padding:15px;box-sizing:border-box}
.rec2-location-dialog {background:white;border-radius:18px;width:min(760px,100%);max-height:95vh;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 24px 65px rgba(0,0,0,.22)}
.rec2-location-dialog__head {padding:15px 18px;display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
.rec2-location-dialog__head h2 {font-size:21px;color:#13213a;margin:0}
.rec2-location-dialog__head p {font-size:13px;color:#5b6777;margin:4px 0 0}
.rec2-location-dialog__close {border:1px solid #dce3e9;background:#fff;border-radius:10px;font-size:26px;min-width:42px;min-height:42px;cursor:pointer}
.rec2-location-dialog__map {height:min(55vh,490px);min-height:250px;width:100%;z-index:0}
.rec2-location-dialog__bottom {padding:12px 18px 18px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
.rec2-location-dialog__coords {font-size:13px;color:#475569;margin:0;font-variant-numeric:tabular-nums}
.rec2-location-dialog__buttons {display:flex;gap:9px}
.rec2-location-dialog__buttons button {border:1px solid #b5c6de;background:white;color:#1d4ed8;border-radius:10px;padding:11px 15px;min-height:44px;font-weight:700;cursor:pointer}
.rec2-location-dialog__buttons .rec2-location-dialog__apply {background:#1d4ed8;color:white;border-color:#1d4ed8}
.rec2-location-dialog__buttons button:disabled {opacity:.5;cursor:not-allowed}
@media(max-width:700px){.rec2-location{padding:14px}.rec2-location__methods{grid-template-columns:1fr}.rec2-location__address{grid-template-columns:1fr}.rec2-location__field--full{grid-column:auto}.rec2-location-dialog__bottom{display:block}.rec2-location-dialog__buttons{margin-top:10px}}
