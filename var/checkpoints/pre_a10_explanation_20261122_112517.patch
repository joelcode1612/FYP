+_CURRENCY_NUMBER_RE = re.compile(
+    r'(?:RM|MYR|USD|SGD|GBP|AUD|EUR|JPY|CNY|RMB|\$|€|£|¥)\s?'
+    r'(\d{1,3}(?:,\d{3})+|\d+)(?:\.\d+)?'
