+
+    assert response.status_code == 503, response.text
+    assert response.json()["detail"]["code"] == "PROPOSAL_DB_TARGET_REFUSED"
+    assert "proposals" not in response.json()
+
+
+# ---------------------------------------------------------------------------
+# Decisions and admission separation
+# ---------------------------------------------------------------------------
+def test_approval_is_recorded_but_admission_stays_held(monkeypatch):
+    world = make_world()
+    client, _, _, _ = build(world, monkeypatch=monkeypatch)
+    created = client.post(endpoint(world) + "/evaluate", json=query(world)).json()
+    proposal_id = created["proposals"][0]["proposal_id"]
+
+    approved = client.post(
+        endpoint(world) + f"/{proposal_id}/decision",
+        json={**query(world), "decision": "APPROVED", "note": "ok"})
+    assert approved.status_code == 200, approved.text
+    body = approved.json()
+    assert body["decision"] == "APPROVED"
+    assert body["decision_created"] is True
+    assert body["review_state"] == "APPROVED"
+    assert body["admission"]["admission_state"] == "HELD"
+    assert body["admission"]["admission_reason"] == "M2_UNCERTAINTY_LINK_REQUIRED"
+    assert body["admission"]["uncertainty_link"] is None
+    assert body["admission"]["qj_execution"] is False
+    assert body["admission"]["qg_execution"] is False
+    assert body["admission"]["fielding_authorized"] is False
+    assert body["qj_execution"] is False and body["qg_execution"] is False
+
+    readback = client.get(endpoint(world) + f"/{proposal_id}/decision",
+                          params=query(world))
+    assert readback.status_code == 200
+    assert readback.json()["decision_id"] == body["decision_id"]
+
+
+def test_rejected_proposal_is_not_admissible(monkeypatch):
+    world = make_world()
+    client, _, _, _ = build(world, monkeypatch=monkeypatch)
+    created = client.post(endpoint(world) + "/evaluate", json=query(world)).json()
+    proposal_id = created["proposals"][1]["proposal_id"]
