# SiteWise mobile build defines — copy to sitewise_dev.env (same folder) and
# edit locally, then run:
#   flutter run --dart-define-from-file=fyp_mobile_app/config/sitewise_dev.env
#
# Precedence: the committed asset assets/config/sitewise_dev.json is loaded
# FIRST at runtime (MobileRuntimeConfig). These defines only fill keys that
# are missing or empty in that asset, so treat this file as the per-machine
# override point (e.g. point a physical phone at a LAN origin instead of
# adb-reverse). Restart the app after any change — defines are compile-time.
#
# Every value here is public by design (the same ones the web app serves).
# NEVER put a secret or service-role key in this file or in dart-defines.

# --- Supabase identity provider -------------------------------------------
SUPABASE_URL=https://lzdpjwmcjbhtkzkqudyt.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XzcdY9fStoqL26NgpIb5VQ_BpFGGLUR

# --- API host selection -----------------------------------------------------
# emulator    -> http://10.0.2.2:8090 (Android emulator on the dev machine)
# adb-reverse -> http://127.0.0.1:8090 as seen from the device; requires
#                `.\run-sitewise.ps1 -Mobile` on the PC with THIS device
#                attached via USB (it installs the adb reverse rule).
# For a phone on the same Wi-Fi, set API_BASE_URL to the PC's LAN IP and
# start the launcher with -AllowLan instead.
API_HOST_MODE=adb-reverse
API_BASE_URL=http://127.0.0.1:8090
WEB_BASE_URL=http://127.0.0.1:8090

# --- Google sign-in (native google_sign_in) --------------------------------
# The Android OAuth client in Google Cloud Console must list the SHA-1 of
# THIS machine's debug keystore (gradlew signingReport) for package
# com.example.fyp, otherwise the sign-in sheet dies as "canceled".
GOOGLE_WEB_CLIENT_ID=235856432090-un8doods8fc5f3bmvtgbjtvojbjg2spa.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=

# --- Development-only auth bypass (compile-time, debug builds) -------------
# true also needs a local dev origin (localhost/127.0.0.1); never ship it.
SITEWISE_DEV_AUTH_BYPASS=false
