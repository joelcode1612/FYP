# Node.js / React / Vue
node_modules/
dist/
build/

# Python
venv/
.venv/
__pycache__/
*.pyc

# Large media / OS specific
.DS_Store
*.mp4
*.zip

# Windows reserved device names
# A shell redirect like `cmd > nul` can create a literal 0-byte file named
# `nul`. Windows resolves the path to the NUL device instead, so `git add`
# fails with `open(".../nul"): No such file or directory` and aborts the
# entire staging operation. These names are illegal on Windows regardless.
nul
con
prn
aux
com1
com2
com3
com4
com5
com6
com7
com8
com9
lpt1
lpt2
lpt3
lpt4
lpt5
lpt6
lpt7
lpt8
lpt9

# Test artifacts and scratch output
.pytest_cache/
pytest-of-*/
pytest_cache/
report.xml
backend/tmp*/
coverage.xml
.coverage
htmlcov/

# Logs
*.log

# Perch generated index (large, rebuilt locally)
.perch/index.json

# FVM Version Cache
.fvm/

# Dart / Flutter generated artifacts — MUST NOT be committed.
# These are (re)written by `pub get`, `flutter test`, `flutter build` and the
# native-asset hook runner on every invocation, so tracking them produces a
# permanently-dirty working tree. Matches at any depth.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# Force ignore all dart_tool and build folders anywhere in the workspace
**/.dart_tool/
**/build/

# Local runtime config (never commit generated keys)
backend/.env.local
*.carto-prepatch.bak

# ---------------------------------------------------------------------------
# Sensitive local artifacts — MUST NOT be committed.
#
# `backend/backups/` is written by scripts/ and holds, among other things:
#   * raw cloud-model completions (`result.json`, `bdj_output.json`, `probe.json`)
#   * full logical database dumps (`*.dump`, one `pg_restore` from plaintext)
#   * a copy of a local `.env` containing live connection strings
# None of it belongs in version control. Note that three files under this path
# were committed before this rule existed; ignoring does not untrack them, and
# removing them from history is a separate, owner-authorised decision.
# ---------------------------------------------------------------------------
backend/backups/

# Environment backups anywhere (`.env.local.XXXXXXXX.bak`). Scoped to `.env`
# so the `.py.bak` / `.dart.bak` source snapshots this project keeps remain
# trackable.
.env*.bak
**/.env*.bak

# CP-04A: the suffix list above was too narrow. `backend/.env.env.bak.execprincipal`
# was created during CP-04A and matched none of it, so `git add -A` would have
# staged SECRET_KEY, SUPABASE_SECRET_KEY and four database URLs. Ignore the whole
# `.env*` family instead of enumerating suffixes, and re-permit only the examples.
**/.env
**/.env.*
!**/.env.example

# CP-03F browser/backend journey harness output: contains declared M2 answer
# text. Untracked and previously unignored, so `git add -A` would have staged it.
backend/var/cp03f_*/

# Runtime E2E / browser scratch output (regenerated; holds Chrome profiles,
# test keys and app.env copies). Zero tracked files in these paths.
backend/var/e2e/
var/backup_build/

# More runtime output: hash-named verification PDFs, test JUNIT/evidence
# dumps and a throwaway ES256 test key. Tracked files remain tracked.
backend/var/verification-documents/
backend/var/evidence/
backend/var/test-auth/

# Owner decision 2026-11-23: hand-off docs, evidence bundles and test modules
# in these folders stay local. Files already tracked remain tracked.
deliverables/
artifacts/
backend/tests/

