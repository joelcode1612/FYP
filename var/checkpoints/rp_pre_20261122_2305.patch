+class FakeAttemptLedger:
+    """Mirrors the reserve-before-dispatch contract of PostgresAttemptLedger."""
+
+    def __init__(self, state):
+        self.state = state
+
+    def reserve(self, stage, prompt_version, prompt_hash, request_hash, *,
+                attempt_slot=1):
+        if stage in [r["stage"] for r in self.state.reserves]:
+            raise WorkflowHeld("MODEL_STAGE_ALREADY_RESERVED")
+        self.state.reserves.append({"stage": stage,
+                                    "prompt_version": prompt_version,
+                                    "prompt_hash": prompt_hash,
+                                    "request_hash": request_hash})
+        return len(self.state.reserves)
+
+    def finish(self, attempt, outcome, output_digest):
+        if outcome not in {"returned", "rejected", "unknown_outcome"}:
+            raise WorkflowHeld("MODEL_RECEIPT_OUTCOME_INVALID")
+        self.state.receipt = (attempt, outcome, output_digest)
