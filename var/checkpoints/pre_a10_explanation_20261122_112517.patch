+class LedgerState:
+    def __init__(self):
+        self.reserves = []
+        self.receipt = None
+        self.run_id = uuid4()
+
+
+class FakeAttemptLedger:
+    """Mirrors the reserve-before-dispatch contract of PostgresAttemptLedger."""
+
+    def __init__(self, state):
+        self.state = state
+
+    def reserve(self, stage, prompt_version, prompt_hash, request_hash, *,
+                attempt_slot=1):
+        if stage in [r["stage"] for r in self.state.reserves]:
+            raise WorkflowHeld("MODEL_STAGE_ALREADY_RESERVED")
+        self.state.reserves.append({"stage": stage,
+                                    "prompt_version": prompt_version,
+                                    "prompt_hash": prompt_hash,
+                                    "request_hash": request_hash})
+        return len(self.state.reserves)
+
+    def finish(self, attempt, outcome, output_digest):
+        if outcome not in {"returned", "rejected", "unknown_outcome"}:
+            raise WorkflowHeld("MODEL_RECEIPT_OUTCOME_INVALID")
+        self.state.receipt = (attempt, outcome, output_digest)
+
+
+class FakeStore:
+    """Mirrors objective_adapter's contract without SQL."""
+
+    def __init__(self, world):
+        self.world = world
+        self.rows = {}
+        self.decisions = {}
+        self.persisted = []
+        self.fail_persist = False
+
+    def persist(self, engine, bound, *, owner_user_id, evaluation_id, assessment_id,
+                confirmation_revision, confirmation_id, source_fingerprint,
+                prompt_version, execution_mode="SIMULATED", model_provider=None,
+                model_requested=None, model_returned=None):
+        if self.fail_persist:
+            raise WorkflowHeld("PROPOSAL_DB_TARGET_REFUSED")
+        assert isinstance(bound, BoundObjectiveProposal)
+        self.persisted.append({
+            "contract_version": bound.contract_version,
+            "context_id": bound.context_id,
+            "context_packet_hash": bound.context_packet_hash,
+            "confirmation_id": bound.confirmation_id,
+            "confirmation_digest": bound.confirmation_digest,
+            "execution_mode": execution_mode,
+            "model_provider": model_provider,
+            "source_fingerprint": source_fingerprint,
+            "prompt_version": prompt_version,
+            "recommendations": len(bound.proposals),
+        })
+        from sitewise.project1.objective_adapter import proposal_identity
+        out = []
+        for rec in bound.proposals:
+            pid = str(proposal_identity(
+                assessment_id=assessment_id,
+                confirmation_revision=confirmation_revision,
+                confirmation_id=confirmation_id,
+                context_packet_hash=bound.context_packet_hash,
+                contract_version=bound.contract_version,
+                prompt_version=prompt_version, recommendation=rec))
+            created = pid not in self.rows
+            self.rows.setdefault(pid, {
+                "proposal_id": pid, "evaluation_id": str(evaluation_id),
+                "assessment_id": str(assessment_id),
+                "confirmation_id": str(confirmation_id),
+                "confirmation_revision": int(confirmation_revision),
+                "source_fingerprint": source_fingerprint,
+                "context_id": bound.context_id,
+                "context_packet_hash": bound.context_packet_hash,
+                "recommendation_status": rec.recommendation_status,
+                "problem_type": rec.problem_type, "problem": rec.problem,
+                "research_objective": rec.research_objective,
+                "reason": rec.reason,
+                "source_refs": [r.model_dump() for r in rec.source_refs],
+                "contract_version": bound.contract_version,
+                "prompt_version": prompt_version,
+                "execution_mode": execution_mode,
+                "validation_status": "VALID",
+                "review_state": "CANDIDATE",
+                "owner_user_id": str(owner_user_id),
+            })
+            out.append({"proposal_id": pid, "created": created})
+        return out
+
+    def read(self, engine, proposal_id, owner_user_id):
+        row = self.rows.get(str(proposal_id))
+        if row is None or row["owner_user_id"] != str(owner_user_id):
+            return None
+        return copy.deepcopy(row)
+
+    def read_for_assessment(self, engine, assessment_id, owner_user_id,
+                            confirmation_revision, limit=50):
+        return [copy.deepcopy(r) for r in self.rows.values()
+                if r["assessment_id"] == str(assessment_id)
+                and r["owner_user_id"] == str(owner_user_id)
+                and r["confirmation_revision"] == int(confirmation_revision)]
+
+    def decide(self, engine, proposal_id, *, actor_id, decision,
+               source_fingerprint, context_packet_hash, note=None):
+        row = self.rows.get(str(proposal_id))
+        if row is None:
+            raise WorkflowHeld("PROPOSAL_NOT_FOUND")
+        if row["owner_user_id"] != str(actor_id):
+            raise WorkflowHeld("PROPOSAL_DECISION_FORBIDDEN")
+        if (row["source_fingerprint"] != source_fingerprint
+                or row["context_packet_hash"] != context_packet_hash):
+            raise WorkflowHeld("PROPOSAL_DECISION_STALE")
+        existing = self.decisions.get(str(proposal_id))
+        if existing is not None:
+            if existing["decision"] == decision:
+                return {"decision_id": existing["decision_id"],
+                        "decision": decision, "created": False}
+            raise WorkflowHeld("PROPOSAL_ALREADY_DECIDED")
+        decision_id = str(uuid4())
+        self.decisions[str(proposal_id)] = {
+            "decision_id": decision_id, "decision": decision,
+            "decided_by": str(actor_id), "decided_at": "2026-11-22T00:00:00Z",
+            "source_fingerprint": source_fingerprint,
+            "context_packet_hash": context_packet_hash, "note": note,
+        }
+        row["review_state"] = decision
+        return {"decision_id": decision_id, "decision": decision, "created": True}
+
+    def read_decision(self, engine, proposal_id, owner_user_id):
+        row = self.rows.get(str(proposal_id))
+        if row is None or row["owner_user_id"] != str(owner_user_id):
+            return None
+        return copy.deepcopy(self.decisions.get(str(proposal_id)))
+
+    def admission_status(self, engine, proposal_id, *, source_fingerprint,
+                         actor_id):
+        # Mirrors objective_adapter.admission_status. The real implementation is
+        # proven against PostgreSQL by the DB harness; this fake keeps the HTTP
+        # contract under test here.
+        row = self.rows.get(str(proposal_id))
+        base = {"qj_execution": False, "qg_execution": False,
+                "fielding_authorized": False, "uncertainty_link": None}
+        if row is None:
+            return {**base, "admission_state": "NOT_ADMISSIBLE",
+                    "admission_reason": "PROPOSAL_NOT_FOUND",
+                    "pending_requirement": None}
+        if row["source_fingerprint"] != source_fingerprint:
+            return {**base, "admission_state": "NOT_ADMISSIBLE",
+                    "admission_reason": "PROPOSAL_SOURCE_STALE",
+                    "pending_requirement": None}
+        decision = (self.decisions.get(str(proposal_id)) or {}).get("decision")
+        if decision != "APPROVED":
+            return {**base, "admission_state": "NOT_ADMISSIBLE",
+                    "admission_reason": "PROPOSAL_NOT_APPROVED",
+                    "pending_requirement": None}
+        return {**base, "admission_state": "HELD",
+                "admission_reason": "M2_UNCERTAINTY_LINK_REQUIRED",
+                "pending_requirement": "Post-confirmation finding authority is "
+                                       "not adopted."}
+
+
