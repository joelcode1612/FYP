+"""Offline HTTP tests for the governed BDJ objective proposal surface.
+
+These run without a database. They exercise the real FastAPI router, the real
+``BDJEngine.propose_objectives``, the real ``ModelRunner``, the real
+``ObjectiveSimulationDisclosure`` and the real ``bdj-objective-proposal/1``
+validators; only the persistence adapter, the attempt ledger and the source
+projector are substituted, because those are proven against PostgreSQL by
+``tools/phase2_gateBC_http_e2e_20261122.py``.
+
+The DB-level harness is authoritative for:
+  * the real ``objective_adapter`` SQL (persistence, decisions, admission);
+  * the real ``PostgresAttemptLedger``;
+  * owner-scoped RLS behaviour.
+
+No test here treats an unexpected exception as a pass: every case asserts a
+specific status code and refusal code.
+"""
+import copy
+from types import SimpleNamespace
+from uuid import uuid4
+
+import pytest
+from fastapi import FastAPI, HTTPException
+from fastapi.testclient import TestClient
+
+from sitewise.api.v1 import project1_objective_proposals as api
+from sitewise.api.v1 import project1_workflow as workflow
+from sitewise.core.config import settings
+from sitewise.project1.contracts import WorkflowHeld, digest
+from sitewise.project1.objective_proposal import BoundObjectiveProposal
+from sitewise.services.business_context_v1 import source_hash
+
+REVISION = 11
+
+DECLARATIONS = [
+    {"item_key": "M2V1-01", "answer_revision_id": "rev-01-r11",
+     "item_version_id": "item-01-v1", "answer_state": "ANSWERED",
+     "value": "UNDECIDED"},
+    {"item_key": "M2V1-02", "answer_revision_id": "rev-02-r11",
+     "item_version_id": "item-02-v1", "answer_state": "ANSWERED",
+     "value": "DINE_IN"},
+    {"item_key": "M2V1-08", "answer_revision_id": "rev-08-r11",
+     "item_version_id": "item-08-v1", "answer_state": "ANSWERED",
+     "value": ["UNKNOWN"]},
+    {"item_key": "M2V1-11", "answer_revision_id": "rev-11-r11",
+     "item_version_id": "item-11-v1", "answer_state": "ANSWERED",
+     "value": "UNSURE"},
+]
+
+
+class Contexts:
+    """Stands in for PersistedBusinessContextService.retrieve."""
+
+    def __init__(self, result):
+        self.result = result
+        self.calls = 0
+
+    def retrieve(self, assessment_id, context_id, actor):
+        self.calls += 1
+        if self.result is None:
+            from sitewise.core.exceptions import NotFoundError
+            raise NotFoundError("Business context not found.")
+        assert str(assessment_id) == str(self.result["assessment_id"])
+        assert str(context_id) == str(self.result["context_id"])
+        assert str(actor.user_id) == str(self.result["owner_id"])
+        return copy.deepcopy(self.result)
+
+
+def make_world():
+    owner, assessment, confirmation, context = uuid4(), uuid4(), uuid4(), uuid4()
+    packet = {
+        "schema_version": "project1-m2-projection/1-candidate",
+        "instrument_version": "M2V1-20261114-1",
+        "assessment_id": str(assessment),
+        "assessment_revision": REVISION,
+        "confirmed": True,
+        "confirmation": {"confirmation_id": str(confirmation),
+                         "snapshot_digest": "d" * 64},
+        "declarations": copy.deepcopy(DECLARATIONS),
+    }
+    # verify_projection() recomputes the fingerprint, so it must be real.
+    packet["source_fingerprint"] = digest(packet)
+
+    context_packet = {
+        "schema_version": "business-context-package/1.1",
+        "context_version": "BCB-V1-TEST",
+        "identity": {"assessment_id": str(assessment), "owner_id": str(owner)},
+        "confirmation": {"id": str(confirmation), "revision": REVISION,
+                         "digest": "d" * 64, "status": "CURRENT_CONFIRMED"},
+        "permissions": {"qj_execution": False, "qg_execution": False},
+        "m2_answers": copy.deepcopy(DECLARATIONS),
+        "business_description": "Synthetic test description.",
+    }
+    context_packet["packet_hash"] = source_hash(context_packet)
+    stored = {
+        "contract_version": "persisted-business-context/1",
+        "context_id": str(context),
+        "assessment_id": str(assessment),
+        "confirmation_id": str(confirmation),
+        "assessment_revision": REVISION,
+        "lifecycle_status": "PERSISTED",
