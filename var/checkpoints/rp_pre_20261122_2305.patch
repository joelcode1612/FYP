diff --git a/fyp_jaspr_web/web/styles.css b/fyp_jaspr_web/web/styles.css
index 6cbd9bd..5d3317f 100644
--- a/fyp_jaspr_web/web/styles.css
+++ b/fyp_jaspr_web/web/styles.css
@@ -19645,3 +19645,227 @@ input[type="range"] {
   color: #1e4aa8;
 }
 .m2q__endpoint { margin: 10px 0 0; }
+
+/* ---------------------------------------------------------------------------
+   chart-spec/1 horizontal bar chart (`ChartSpecView`).
+
+   Scoped to `.sw-chart` and appended at the end of the sheet so it cannot
+   change `.sw-viz__*`, which the property-detail visualisation owns. Colours
+   come from tokens so the dark theme applies without a second block.
+
+   Layout: label | track | count | percentage. The count and the percentage are
+   separate columns because a chart-spec may legitimately carry a count with no
+   percentage (V = 0, or findings withheld); collapsing them would let a missing
+   percentage read as a zero.
+   --------------------------------------------------------------------------- */
+.sw-chart {
+  margin: 0;
+  border: 1px solid var(--border);
+  border-radius: var(--radius-sm);
+  background: var(--surface);
+  overflow: hidden;
+  min-width: 0;
+}
+.sw-chart__head { padding: 16px 18px 0; }
+.sw-chart__eyebrow { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 10px; }
+.sw-chart__head h3 { margin: 0 0 6px; font-size: 14.5px; line-height: 1.35; color: var(--ink); }
+.sw-chart__question { margin: 0; font-size: 12.5px; line-height: 1.6; color: var(--muted); max-width: 78ch; }
+
+.sw-chart__bars { display: grid; gap: 9px; padding: 18px; }
+.sw-chart__bar {
+  display: grid;
+  grid-template-columns: minmax(96px, 148px) minmax(0, 1fr) 52px 76px;
+  align-items: center;
+  gap: 10px;
+}
+.sw-chart__bar-label { font-size: 11.5px; font-weight: 700; color: var(--ink); overflow-wrap: anywhere; }
+.sw-chart__bar-track {
+  display: block;
+  height: 12px;
+  border-radius: 999px;
+  background: var(--paper);
+  overflow: hidden;
+}
+.sw-chart__bar-fill {
+  display: block;
+  height: 100%;
+  border-radius: inherit;
+  background: var(--action);
+  opacity: .5;
+  transition: width 240ms ease;
+}
+/* The tied-highest options are marked, not ranked: a tie stays a tie. */
+.sw-chart__bar.is-top .sw-chart__bar-fill { opacity: 1; }
+.sw-chart__bar-count {
+  font-size: 12px;
+  font-weight: 800;
+  color: var(--ink);
+  text-align: right;
+  font-variant-numeric: tabular-nums;
+}
+.sw-chart__bar-pct {
+  font-size: 12px;
+  font-weight: 700;
+  color: var(--muted);
+  text-align: right;
+  font-variant-numeric: tabular-nums;
+}
+
+.sw-chart__notice {
+  display: flex;
+  gap: 12px;
+  margin: 16px 18px 0;
+  padding: 14px 16px;
+  border: 1px dashed var(--border-strong);
+  border-radius: var(--radius-sm);
+  background: var(--paper);
+}
+.sw-chart__notice .ms { flex: none; color: var(--warning); }
+.sw-chart__notice-body { min-width: 0; }
+.sw-chart__notice-title { margin: 0 0 3px; font-size: 12.5px; font-weight: 800; color: var(--ink); }
+.sw-chart__notice-text { margin: 0; font-size: 11.5px; line-height: 1.6; color: var(--muted); }
+
+/* The accessible representation. Visible rather than visually hidden: a report
+   reader needs the exact counts, and a screen-reader user gets them once. */
+.sw-chart__table { width: 100%; margin: 16px 0 0; border-collapse: collapse; font-size: 11.5px; }
+.sw-chart__table caption {
+  padding: 0 18px 8px;
+  text-align: left;
+  font-size: 10px;
+  letter-spacing: .05em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+.sw-chart__table th,
+.sw-chart__table td { padding: 7px 12px; border-top: 1px solid var(--border); vertical-align: top; }
+.sw-chart__table thead th {
+  padding-top: 0;
+  border-top: none;
+  font-size: 10px;
+  font-weight: 700;
+  letter-spacing: .05em;
+  text-transform: uppercase;
+  color: var(--muted);
+  text-align: left;
+}
+.sw-chart__table tbody th { font-weight: 700; color: var(--ink); text-align: left; }
+.sw-chart__table td { color: var(--muted); font-variant-numeric: tabular-nums; text-align: left; }
+.sw-chart__table th:not(:first-child),
+.sw-chart__table td:not(:first-child) { text-align: right; }
+.sw-chart__table tbody tr:last-child th,
+.sw-chart__table tbody tr:last-child td { padding-bottom: 12px; }
+
+.sw-chart__derived {
+  margin: 14px 18px 0;
+  padding: 12px 14px;
+  border: 1px solid var(--border);
+  border-radius: var(--radius-sm);
+  background: var(--alt-surface);
+}
+.sw-chart__derived-head {
+  margin: 0 0 8px;
+  font-size: 10px;
+  font-weight: 700;
+  letter-spacing: .05em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+.sw-chart__derived-row {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  gap: 3px 12px;
+  padding: 7px 0;
+  border-top: 1px solid var(--border);
+}
+.sw-chart__derived-row:first-of-type { border-top: none; padding-top: 0; }
+.sw-chart__derived-label { font-size: 12px; font-weight: 700; color: var(--ink); }
+.sw-chart__derived-value {
+  font-size: 12px;
+  font-weight: 800;
+  color: var(--ink);
+  font-variant-numeric: tabular-nums;
+}
+.sw-chart__derived-formula { grid-column: 1 / -1; font-size: 10.5px; line-height: 1.5; color: var(--muted); }
+
+.sw-chart__denominator { margin: 14px 18px 0; font-size: 11px; line-height: 1.6; color: var(--muted); }
+
+.sw-chart__limits {
+  margin: 14px 18px 0;
+  padding: 12px 14px;
+  border-left: 3px solid var(--warning);
+  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
+  background: var(--warning-wash, var(--paper));
+}
+.sw-chart__limits-head {
+  margin: 0 0 6px;
+  font-size: 10px;
+  font-weight: 800;
+  letter-spacing: .05em;
+  text-transform: uppercase;
+  color: var(--warning);
+}
+.sw-chart__limits ul { margin: 0; padding-left: 16px; }
+.sw-chart__limits li { font-size: 11px; line-height: 1.6; color: var(--ink); }
+.sw-chart__limits li + li { margin-top: 4px; }
+
+.sw-chart__foot {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px 18px;
+  margin-top: 16px;
+  padding: 14px 18px 16px;
+  border-top: 1px solid var(--border);
+  background: var(--alt-surface);
+}
+.sw-chart__foot-item { display: grid; gap: 1px; min-width: 0; }
+.sw-chart__foot-label {
+  font-size: 9.5px;
+  font-weight: 700;
+  letter-spacing: .05em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+.sw-chart__foot-value { font-size: 11px; font-weight: 600; color: var(--ink); overflow-wrap: anywhere; }
+.sw-chart__note { flex-basis: 100%; margin: 4px 0 0; font-size: 10.5px; line-height: 1.55; color: var(--muted); }
+
+@media (max-width: 760px) {
+  .sw-chart__bar { grid-template-columns: minmax(80px, 112px) minmax(0, 1fr) 44px 64px; gap: 8px; }
+  .sw-chart__bar-label,
+  .sw-chart__bar-count,
+  .sw-chart__bar-pct { font-size: 11px; }
+  .sw-chart__table { font-size: 11px; }
+  .sw-chart__table th,
+  .sw-chart__table td { padding: 6px 9px; }
+}
+
+/* Narrow phones: the track moves under its own label so the label never
+   truncates and the count and share stay aligned on one line. */
+@media (max-width: 520px) {
+  .sw-chart__bar {
+    grid-template-columns: minmax(0, 1fr) minmax(26px, auto) minmax(38px, auto);
+    grid-template-areas: "label count pct" "track track track";
+    gap: 5px 10px;
+  }
+  .sw-chart__bar-label { grid-area: label; }
+  .sw-chart__bar-track { grid-area: track; }
+  .sw-chart__bar-count { grid-area: count; }
+  .sw-chart__bar-pct { grid-area: pct; }
+
+  /* Four columns at 12px padding exceed a 360px viewport, so the table used to
+     run off the right edge. Tighter padding plus wrapping headers keeps the
+     whole table inside the card; nothing is hidden to achieve it. */
+  .sw-chart__table { font-size: 10.5px; table-layout: fixed; }
+  .sw-chart__table th,
+  .sw-chart__table td { padding: 5px 4px; overflow-wrap: anywhere; }
+  .sw-chart__table caption { padding: 0 12px 8px; }
+  .sw-chart__head { padding: 14px 12px 0; }
+  .sw-chart__bars { padding: 14px 12px; }
+  .sw-chart__derived,
+  .sw-chart__limits { margin-left: 12px; margin-right: 12px; }
+  .sw-chart__denominator { margin-left: 12px; margin-right: 12px; }
+  .sw-chart__foot { padding: 12px 12px 14px; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .sw-chart__bar-fill { transition: none; }
+}
