# Node.js / React / Vue
node_modules/
dist/
build/

# Python
venv/
.venv/
__pycache__/
*.pyc

# Large media / OS specific
.DS_Store
*.mp4
*.zip

# Windows reserved device names
# A shell redirect like `cmd > nul` can create a literal 0-byte file named
# `nul`. Windows resolves the path to the NUL device instead, so `git add`
# fails with `open(".../nul"): No such file or directory` and aborts the
# entire staging operation. These names are illegal on Windows regardless.
nul
con
prn
aux
com1
com2
com3
com4
com5
com6
com7
com8
com9
lpt1
lpt2
lpt3
lpt4
lpt5
lpt6
lpt7
lpt8
lpt9

# Test artifacts and scratch output
.pytest_cache/
pytest-of-*/
pytest_cache/
report.xml
backend/tmp*/
coverage.xml
.coverage
htmlcov/

# Logs
*.log

# Perch generated index (large, rebuilt locally)
.perch/index.json

# FVM Version Cache
.fvm/

# Dart / Flutter generated artifacts — MUST NOT be committed.
# These are (re)written by `pub get`, `flutter test`, `flutter build` and the
# native-asset hook runner on every invocation, so tracking them produces a
# permanently-dirty working tree. Matches at any depth.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies