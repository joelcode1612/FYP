      "answer_kind": "COMPOSITE",
      "option_values": {
        "contract": "m2-item-options/1",
        "options": [],
        "rules": {
          "concept_preview": {
            "source": "CONFIRMED_OR_DRAFT_M2_ANSWERS",
            "deterministic": true,
            "persisted_as_answer": false,
            "derived_from": [
              "M2V2-01",
              "M2V2-02",
              "M2V2-03",
              "M2V2-04",
              "M2V2-05",
              "M2V2-06",
              "M2V2-07",
              "M2V2-08",
              "M2V2-09",
              "M2V2-10",
              "M2V2-11"
            ]
          }
        },
        "source_rules": [
          "Rule: the concept preview is deterministic and is never stored as an answer. The finalised BCB is derived only from the subsequently confirmed revision."
        ],
        "value_schema": {
          "contract": "m2-composite/1",
          "fields": [
            {
              "name": "review_status",
              "type": "ENUM",
              "required": true,
              "values": [
                "CONFIRMED",
                "NEEDS_CORRECTION",
                "NOT_READY"
              ]
            },
            {
              "name": "title",
              "type": "TEXT",
              "required": false,
              "max_length": 200
            },
            {
              "name": "details",
              "type": "TEXT",
              "required": false,
              "max_length": 4000
            }
          ],
          "conditional_required": [
            {
              "field": "details",
              "when": {
                "field": "review_status",
                "in": [
                  "NEEDS_CORRECTION",
                  "NOT_READY"
                ]
              }
            }
          ]
        }
      },
      "allowed_states": [
        "ANSWERED",
        "NOT_PROVIDED"
