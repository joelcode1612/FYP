+    body = rejected.json()
+    assert body["review_state"] == "REJECTED"
+    assert body["admission"]["admission_state"] == "NOT_ADMISSIBLE"
+    assert body["admission"]["admission_reason"] == "PROPOSAL_NOT_APPROVED"
+
+
+def test_pending_proposal_has_no_decision(monkeypatch):
+    world = make_world()
+    client, _, _, _ = build(world, monkeypatch=monkeypatch)
+    created = client.post(endpoint(world) + "/evaluate", json=query(world)).json()
+    proposal_id = created["proposals"][2]["proposal_id"]
+
+    response = client.get(endpoint(world) + f"/{proposal_id}/decision",
+                          params=query(world))
+    assert response.status_code == 404
+    assert response.json()["detail"]["code"] == "BDJ_OBJECTIVE_DECISION_NOT_FOUND"
+
+
+def test_conflicting_decision_is_refused(monkeypatch):
+    world = make_world()
+    client, _, _, _ = build(world, monkeypatch=monkeypatch)
+    created = client.post(endpoint(world) + "/evaluate", json=query(world)).json()
+    proposal_id = created["proposals"][0]["proposal_id"]
+
+    first = client.post(endpoint(world) + f"/{proposal_id}/decision",
+                        json={**query(world), "decision": "APPROVED"})
+    assert first.status_code == 200
+
+    repeat = client.post(endpoint(world) + f"/{proposal_id}/decision",
+                         json={**query(world), "decision": "APPROVED"})
+    assert repeat.status_code == 200
+    assert repeat.json()["decision_created"] is False
+    assert repeat.json()["decision_id"] == first.json()["decision_id"]
+
+    conflict = client.post(endpoint(world) + f"/{proposal_id}/decision",
+                           json={**query(world), "decision": "REJECTED"})
+    assert conflict.status_code == 409
+    assert conflict.json()["detail"]["code"] == "BDJ_OBJECTIVE_ALREADY_DECIDED"
+
+
+def test_decision_on_stale_source_is_refused(monkeypatch):
+    world = make_world()
+    client, _, _, _ = build(world, monkeypatch=monkeypatch)
+    created = client.post(endpoint(world) + "/evaluate", json=query(world)).json()
+    proposal_id = created["proposals"][0]["proposal_id"]
+
+    from sitewise.project1 import objective_adapter
+
+    def stale(*args, **kwargs):
+        raise WorkflowHeld("PROPOSAL_DECISION_STALE")
+
+    monkeypatch.setattr(objective_adapter, "decide", stale)
+    response = client.post(endpoint(world) + f"/{proposal_id}/decision",
